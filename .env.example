# Mongo-compatible connection string.
#   Local dev:  mongodb://localhost:27017
#   Prod:       mongodb+srv://<user>:<password>@<cluster>... (Cosmos DB for MongoDB vCore)
MONGODB_URI=

# Optional — defaults to "budget". Use "budget-dev" locally so dev and prod
# point at different databases when the URIs happen to converge.
MONGODB_DB_NAME=budget

# Set to "false" only on RU-based Cosmos (vCore and real Mongo support
# retryable writes natively).
# MONGODB_RETRY_WRITES=false

# --- Clerk authentication (#111, ADR 0004) ---
# Auth is Clerk for *identity only*; households/roles/invites are ours.
#
# Local dev setup (one-time):
#   1. Create a Clerk application at https://dashboard.clerk.com.
#   2. Under "User & Authentication" → enable **Google** as the only sign-in
#      option (disable email/password and other providers). Dev instances ship
#      Clerk's shared Google OAuth credentials, so no Google Cloud setup is
#      needed locally.
#   3. Copy the two keys below from the Clerk dashboard (API Keys) into
#      .env.local. The publishable key is safe to expose; the secret key is not.
#   4. The first person to sign in bootstraps the household as owner and adopts
#      all existing data; invite others from Settings (chunk 6).
#
# Production also needs the real Google OAuth client configured on the Clerk
# production instance, and the prod Frontend API host added to the CSP in
# next.config.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk's SDK pings clerk-telemetry.com with anonymous usage data on dev
# instances (for Clerk's roadmap — no benefit to us; it also trips a benign
# CORS console error). Uncomment to silence it.
# CLERK_TELEMETRY_DISABLED=1

# --- Investment prices (#109 / #143, ADR 0003) ---
# Server-only; mark Sensitive in the hosting env. Never NEXT_PUBLIC_.
#
# Tiingo is the app's sole market-data provider — its end-of-day endpoint prices
# stocks, ETFs, and mutual-fund NAVs (401k / index / target-date funds), and its
# utilities/search endpoint backs the add-holding autocomplete (#144). Free tier:
# personal/non-commercial, 500 unique symbols/month, 50 req/hour — ample given the
# 12h quote cache, monthly check-in cadence, and debounced+cached search. Sign up
# at https://www.tiingo.com and confirm your fund tickers resolve before relying
# on it (share-class / non-US funds can be finicky). Without it, every holding
# needs a manual price override and search returns nothing.
TIINGO_API_KEY=
